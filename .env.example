# LiteLLM API Key Pool (at least 2 keys, assigned key_1, key_2, ... in order)
LLM_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here

# SQLite Database Location (Volume-backed for persistence)
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure test hook for failover demonstration
ENABLE_FAILURE_SIMULATION=true

# Target LLM Model
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Frontend API Base URL (used when deploying or building frontend)
VITE_API_BASE_URL=http://localhost:8000
